# Copy this file to .env and fill in your values.
# The system works fully locally without any API keys.

# Optional: Switch to OpenAI embeddings by setting this key.
# OPENAI_API_KEY=sk-...

# Optional: Cohere embeddings
# COHERE_API_KEY=...

# Embedding model to use. Default: sentence-transformers (local)
# Options: "local" | "openai" | "cohere"
EMBEDDING_BACKEND=local

# Local sentence-transformers model name
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB storage path (relative to project root)
CHROMA_DB_PATH=./chroma_db

# ChromaDB collection name
CHROMA_COLLECTION_NAME=resumes

# Default top-K for job matching
DEFAULT_TOP_K=10
